/*
 * Daylight: the light theme of DePhantom Universal Death Counter.
 *
 * Same layout as Phantom Dark (dark.qss) with light layers: window #f3f4f8,
 * sidebar/top bar and cards white, controls #eef0f4. Crimson (#e3263f) marks
 * what matters; DePhantom purple (#7e22ce) is for the brand touches only.
 *
 * Keep the first rule's "background-color" / "color" lines as they are:
 * theme_manager swaps them for the player's text color and background image.
 */

QWidget {
    background-color: #f3f4f8;
    color: #1b1c21;
    font-family: "Segoe UI Variable Text", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #f3f4f8;
}

QToolTip {
    background-color: #eef0f4;
    color: #1b1c21;
    border: 1px solid #d9dce4;
    border-radius: 8px;
    padding: 6px 9px;
}

QLabel {
    background-color: transparent;
}

/* ---------------------------------------------------------------- shell */

QFrame#TopBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e4e6ec;
}

QFrame#TopBar QWidget, QFrame#Sidebar QWidget {
    background-color: transparent;
}

QLabel#TitleLabel {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 19px;
    font-weight: 800;
    color: #111216;
    letter-spacing: 0.3px;
}

QLabel#Subtitle {
    color: #e3263f;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#PageBadge {
    color: #626674;
    font-size: 12px;
    font-weight: 600;
    padding-left: 14px;
    border-left: 1px solid #e2e4ea;
}

QPushButton#TopIconButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 0;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
}

QPushButton#TopIconButton:hover {
    background-color: #eceef3;
    border: 1px solid #d9dce4;
}

QPushButton#TopIconButton::menu-indicator {
    image: none;
    width: 0;
}

QFrame#Sidebar {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                      stop: 0 #ffffff, stop: 1 #fafbfd);
    border-right: 1px solid #e4e6ec;
}

QLabel#NavSection {
    color: #9a9eaa;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
    padding: 14px 22px 6px 22px;
}

QPushButton#NavButton {
    background-color: transparent;
    color: #626674;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 9px 12px;
    margin: 1px 10px;
    text-align: left;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#NavButton:hover {
    color: #1b1c21;
    background-color: #eef0f4;
}

QPushButton#NavButton:checked {
    color: #111216;
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                      stop: 0 rgba(227, 38, 63, 0.22),
                                      stop: 1 rgba(227, 38, 63, 0.04));
    border: 1px solid rgba(227, 38, 63, 0.35);
}

QLabel#NavState {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
    border-radius: 7px;
    padding: 2px 7px;
    color: #7a7e8a;
    background-color: #eceef3;
    border: 1px solid #e2e4ea;
}

QLabel#NavState[on="true"] {
    color: #ffffff;
    background-color: #1f9d55;
    border: 1px solid #1f9d55;
}

QFrame#CreditCard {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                      stop: 0 rgba(126, 34, 206, 0.16),
                                      stop: 1 rgba(126, 34, 206, 0.03));
    border: 1px solid rgba(126, 34, 206, 0.30);
    border-radius: 12px;
}

QFrame#CreditCard:hover {
    border: 1px solid rgba(126, 34, 206, 0.70);
}

QLabel#CreditSmall {
    color: #626674;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

QLabel#CreditName {
    color: #7e22ce;
    font-size: 13px;
    font-weight: 800;
}

QLabel#NavFooter {
    color: #9a9eaa;
    font-size: 10px;
    padding: 6px 22px 2px 22px;
}

QLabel#PageTitle {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 22px;
    font-weight: 800;
    color: #111216;
}

QLabel#PageSubtitle, QLabel#Muted {
    color: #626674;
    font-size: 12px;
}

QLabel#FieldLabel, QLabel#SectionTitle {
    color: #7a7e8a;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.8px;
}

/* ---------------------------------------------------------------- cards */

QFrame#Card, QFrame#StatTile {
    background-color: #ffffff;
    border: 1px solid #e2e4ea;
    border-radius: 16px;
}

QFrame#StatTile {
    background-color: rgba(17, 18, 22, 0.015);
    border: 1px solid #e2e4ea;
    border-radius: 14px;
}

QFrame#HeroCard {
    border: 1px solid #f5c6ce;
    border-radius: 20px;
    background-color: qradialgradient(cx: 0.5, cy: 0.0, radius: 1.1, fx: 0.5, fy: 0.0,
                                      stop: 0 #ffdfe4, stop: 0.55 #fff5f6, stop: 1 #ffffff);
}

QLabel#CounterLabel {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 92px;
    font-weight: 900;
    color: #e3263f;
}

QLabel#CounterCaption {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 4px;
    color: #4a4e5a;
}

QLabel#SubCounterLabel {
    font-size: 13px;
    color: #626674;
}

QLabel#StatValue {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 24px;
    font-weight: 800;
    color: #111216;
}

QLabel#StatLabel {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #6b6f7b;
}

QLabel#TimerValue {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 60px;
    font-weight: 800;
    color: #111216;
}

QLabel#StatusPill {
    background-color: #eef0f4;
    border: 1px solid #d9dce4;
    border-radius: 13px;
    padding: 5px 14px;
    color: #3b3e48;
    font-size: 12px;
    font-weight: 600;
}

QLabel#StatusPill[state="active"] {
    background-color: rgba(58, 208, 122, 0.12);
    border: 1px solid rgba(58, 208, 122, 0.45);
    color: #157a41;
}

QLabel#StatusPill[state="warning"] {
    background-color: rgba(240, 160, 48, 0.12);
    border: 1px solid rgba(240, 160, 48, 0.45);
    color: #a3620a;
}

QLabel#KeyCap {
    background-color: rgba(17, 18, 22, 0.036);
    border: 1px solid rgba(17, 18, 22, 0.084);
    border-bottom: 2px solid rgba(17, 18, 22, 0.120);
    border-radius: 6px;
    padding: 1px 7px;
    font-size: 11px;
    font-weight: 700;
    color: #4a4e5a;
}

QLabel#GuideBadge {
    background-color: rgba(227, 38, 63, 0.14);
    border: 1px solid rgba(227, 38, 63, 0.35);
    border-radius: 36px;
}

QLabel#StepDot {
    background-color: #d9dce4;
    border-radius: 4px;
}

QLabel#StepDot[active="true"] {
    background-color: #e3263f;
}

/* ---------------------------------------------------------------- buttons */

QPushButton {
    background-color: #eef0f4;
    color: #1b1c21;
    border: 1px solid #d9dce4;
    border-radius: 10px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #e6e8ee;
    border: 1px solid #c3c7d1;
}

QPushButton:pressed {
    background-color: #ffffff;
}

QPushButton:checked {
    border: 1px solid rgba(227, 38, 63, 0.6);
    background-color: rgba(227, 38, 63, 0.12);
}

QPushButton:disabled {
    color: #a5a9b4;
    border: 1px solid #eef0f4;
}

QPushButton QLabel {
    background-color: transparent;
}

QPushButton#AccentButton {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                      stop: 0 #f0384f, stop: 1 #cc1734);
    color: #ffffff;
    border: 1px solid #e3263f;
}

QPushButton#AccentButton:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                      stop: 0 #f54d62, stop: 1 #d92440);
}

QPushButton#AccentButton:pressed {
    background-color: #b8142e;
}

QPushButton#AccentButton QLabel {
    color: #ffffff;
}

QPushButton#AccentButton QLabel#KeyCap {
    background-color: rgba(0, 0, 0, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-bottom: 2px solid rgba(255, 255, 255, 0.45);
    color: #ffffff;
}

QPushButton#DangerButton {
    background-color: transparent;
    color: #cc1f37;
    border: 1px solid #f2b8c1;
}

QPushButton#DangerButton:hover {
    background-color: rgba(227, 38, 63, 0.10);
    border: 1px solid #e3263f;
}

QPushButton#DangerButton QLabel {
    color: #cc1f37;
}

QPushButton#GhostButton {
    background-color: transparent;
    color: #555966;
    border: 1px solid transparent;
}

QPushButton#GhostButton:hover {
    color: #111216;
    background-color: #eef0f4;
    border: 1px solid #d9dce4;
}

QPushButton#IconButton {
    padding: 0;
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    border-radius: 10px;
}

QPushButton#IconButton:hover {
    border: 1px solid #e3263f;
}

/* ---------------------------------------------------------------- inputs */

QComboBox {
    background-color: #eef0f4;
    border: 1px solid #d9dce4;
    border-radius: 10px;
    padding: 8px 12px;
    color: #1b1c21;
}

QComboBox:hover {
    border: 1px solid #c3c7d1;
}

QComboBox:focus {
    border: 1px solid #b4b8c3;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox::down-arrow {
    image: url(@ICONS@/ui/chevron-down-light.png);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    selection-background-color: #e3263f;
    selection-color: #ffffff;
    border: 1px solid #d9dce4;
    border-radius: 8px;
    outline: none;
    padding: 4px;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QKeySequenceEdit {
    background-color: #eef0f4;
    border: 1px solid #d9dce4;
    border-radius: 10px;
    padding: 7px 12px;
    color: #1b1c21;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #e3263f;
}

QCheckBox {
    spacing: 10px;
    background-color: transparent;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 1px solid #c3c7d1;
    background-color: #eef0f4;
}

QCheckBox::indicator:hover {
    border: 1px solid #e3263f;
}

QCheckBox::indicator:checked {
    background-color: #e3263f;
    border: 1px solid #e3263f;
    image: url(@ICONS@/check.png);
}

QSlider {
    background-color: transparent;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #d9dce4;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #e3263f;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 3px solid #e3263f;
    width: 12px;
    height: 12px;
    margin: -7px 0;
    border-radius: 9px;
}

QProgressBar {
    background-color: #eef0f4;
    border: 1px solid #d9dce4;
    border-radius: 8px;
    text-align: center;
    color: #1b1c21;
}

QProgressBar::chunk {
    background-color: #e3263f;
    border-radius: 7px;
}

/* ---------------------------------------------------------------- lists & tables */

QListWidget, QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e2e4ea;
    border-radius: 12px;
    gridline-color: #e2e4ea;
    alternate-background-color: #f6f7fa;
    padding: 4px;
}

QListWidget::item {
    padding: 8px;
    border-radius: 8px;
}

QListWidget::item:hover {
    background-color: #eef0f4;
}

QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #e3263f;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #ffffff;
    color: #626674;
    border: none;
    border-bottom: 1px solid #e2e4ea;
    padding: 7px 8px;
    font-weight: 700;
}

/* ---------------------------------------------------------------- tabs & groups */

QTabWidget::pane {
    border: 1px solid #e2e4ea;
    border-radius: 14px;
    top: -1px;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: transparent;
    color: #626674;
    padding: 9px 16px;
    margin-right: 4px;
    border: 1px solid transparent;
    border-radius: 10px;
    font-weight: 700;
}

QTabBar::tab:hover {
    color: #1b1c21;
    background-color: #ffffff;
}

QTabBar::tab:selected {
    color: #111216;
    background-color: rgba(227, 38, 63, 0.14);
    border: 1px solid rgba(227, 38, 63, 0.40);
}

QGroupBox {
    background-color: #fafbfc;
    border: 1px solid #e2e4ea;
    border-radius: 14px;
    margin-top: 16px;
    padding: 16px 14px 12px 14px;
    font-weight: 800;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #626674;
}

QGroupBox QWidget {
    background-color: transparent;
}

QGroupBox QComboBox, QGroupBox QLineEdit, QGroupBox QSpinBox,
QGroupBox QDoubleSpinBox, QGroupBox QKeySequenceEdit, QGroupBox QPushButton {
    background-color: #eef0f4;
}

QFrame#ThemeCard {
    background-color: #ffffff;
    border: 1px solid #e2e4ea;
    border-radius: 14px;
}

QFrame#ThemeCard:hover {
    border: 1px solid #c3c7d1;
}

QFrame#ThemeCard[selected="true"] {
    border: 2px solid #e3263f;
}

QFrame#ThemeCard QWidget {
    background-color: transparent;
}

QFrame#ThemeCard QPushButton {
    background-color: #eef0f4;
    padding: 4px 10px;
    font-size: 12px;
}

/* ---------------------------------------------------------------- menus */

QMenuBar {
    background-color: #ffffff;
    color: #555966;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d9dce4;
    border-radius: 10px;
    padding: 5px;
}

QMenu::item {
    padding: 7px 24px 7px 12px;
    border-radius: 7px;
    background-color: transparent;
}

QMenu::item:selected {
    background-color: rgba(227, 38, 63, 0.85);
    color: #ffffff;
}

QMenu::item:disabled {
    color: #a5a9b4;
}

QMenu::icon {
    padding-left: 8px;
}

QMenu::separator {
    height: 1px;
    background: #d9dce4;
    margin: 5px 8px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 6px;
}

/* ---------------------------------------------------------------- scrollbars */

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #d9dce4;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #e3263f;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ---------------------------------------------------------------- update card */

QFrame#UpdateCard {
    background-color: #ffffff;
    border: 1px solid #e2e4ea;
    border-radius: 12px;
}

QFrame#UpdateCard[state="available"] {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                      stop: 0 rgba(227, 38, 63, 0.12), stop: 1 rgba(227, 38, 63, 0.02));
    border: 1px solid rgba(227, 38, 63, 0.40);
}

QFrame#UpdateCard QWidget {
    background-color: transparent;
}

QLabel#UpdateTitle {
    color: #111216;
    font-size: 12px;
    font-weight: 800;
}

QLabel#UpdateDetail {
    color: #626674;
    font-size: 11px;
}

QPushButton#UpdateCheck {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 0;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
}

QPushButton#UpdateCheck:hover {
    background-color: #eef0f4;
    border: 1px solid #e2e4ea;
}

QFrame#UpdateCard QPushButton#AccentButton {
    padding: 7px 10px;
    font-size: 12px;
}
