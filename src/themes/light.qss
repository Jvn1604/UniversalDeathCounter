/*
 * Light theme for DePhantom Universal Death Counter: the dashboard layout
 * of dark.qss in light colors, with the same crimson accent (#d62f3d).
 *
 * Keep the first rule's "background-color" / "color" lines as they are:
 * theme_manager swaps them for the player's text color and background image.
 */

QWidget {
    background-color: #f4f5f8;
    color: #1b1c21;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #f4f5f8;
}

QToolTip {
    background-color: #ffffff;
    color: #1b1c21;
    border: 1px solid #d9dce4;
    border-radius: 6px;
    padding: 6px 8px;
}

/* ---------------------------------------------------------------- shell */

QFrame#TopBar QLabel, QFrame#Sidebar QLabel {
    background-color: transparent;
}

QFrame#TopBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e3e5ec;
}

QLabel#TitleLabel {
    font-size: 18px;
    font-weight: 700;
    color: #111216;
    letter-spacing: 0.5px;
}

QLabel#Subtitle {
    color: #d62f3d;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
}

QFrame#Sidebar {
    background-color: #ffffff;
    border-right: 1px solid #e3e5ec;
}

QPushButton#NavButton {
    background-color: transparent;
    color: #6b7080;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0;
    padding: 11px 18px 11px 16px;
    text-align: left;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#NavButton:hover {
    color: #1b1c21;
    background-color: #f4f5f8;
}

QPushButton#NavButton:checked {
    color: #111216;
    background-color: rgba(214, 47, 61, 0.08);
    border-left: 3px solid #d62f3d;
}

QLabel#NavFooter {
    color: #a3a7b3;
    font-size: 10px;
    padding: 8px 16px;
}

QLabel#PageTitle {
    font-size: 20px;
    font-weight: 700;
    color: #111216;
}

QLabel#PageSubtitle, QLabel#Muted {
    color: #6b7080;
    font-size: 12px;
}

QLabel#FieldLabel, QLabel#SectionTitle {
    color: #6b7080;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

/* ---------------------------------------------------------------- cards */

QFrame#Card, QFrame#HeroCard, QFrame#StatTile {
    background-color: #ffffff;
    border: 1px solid #e3e5ec;
    border-radius: 14px;
}

QFrame#HeroCard {
    border: 1px solid #f1c9cd;
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                      stop: 0 #fff3f4, stop: 1 #ffffff);
}

QFrame#Card QLabel, QFrame#HeroCard QLabel, QFrame#StatTile QLabel {
    background-color: transparent;
}

QLabel#CounterLabel {
    font-size: 68px;
    font-weight: 800;
    color: #d62f3d;
}

QLabel#CounterCaption {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    color: #6b7080;
}

QLabel#SubCounterLabel {
    font-size: 13px;
    color: #6b7080;
}

QLabel#StatValue {
    font-size: 22px;
    font-weight: 700;
    color: #111216;
}

QLabel#StatLabel {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #6b7080;
}

QLabel#TimerValue {
    font-size: 52px;
    font-weight: 800;
    color: #111216;
}

QLabel#StatusPill {
    background-color: #eef0f4;
    border: 1px solid #d9dce4;
    border-radius: 11px;
    padding: 4px 12px;
    color: #4a4e5a;
    font-size: 12px;
}

QLabel#StatusPill[state="active"] {
    background-color: rgba(28, 160, 90, 0.10);
    border: 1px solid rgba(28, 160, 90, 0.40);
    color: #157a45;
}

QLabel#StatusPill[state="warning"] {
    background-color: rgba(214, 130, 20, 0.10);
    border: 1px solid rgba(214, 130, 20, 0.40);
    color: #9a5c08;
}

/* ---------------------------------------------------------------- buttons */

QPushButton {
    background-color: #ffffff;
    color: #1b1c21;
    border: 1px solid #d9dce4;
    border-radius: 9px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #f4f5f8;
    border: 1px solid #d62f3d;
}

QPushButton:pressed {
    background-color: #eef0f4;
}

QPushButton:disabled {
    color: #a3a7b3;
    border: 1px solid #e3e5ec;
}

QPushButton#AccentButton {
    background-color: #d62f3d;
    color: #ffffff;
    border: none;
}

QPushButton#AccentButton:hover {
    background-color: #e04955;
}

QPushButton#AccentButton:pressed {
    background-color: #b82633;
}

QPushButton#BigAction {
    font-size: 16px;
    padding: 14px 18px;
    border-radius: 12px;
}

QPushButton#DangerButton {
    background-color: transparent;
    color: #c62835;
    border: 1px solid #f1c9cd;
}

QPushButton#DangerButton:hover {
    background-color: rgba(214, 47, 61, 0.08);
    border: 1px solid #d62f3d;
}

QPushButton#GhostButton {
    background-color: transparent;
    color: #4a4e5a;
    border: 1px solid transparent;
}

QPushButton#GhostButton:hover {
    color: #111216;
    background-color: #ffffff;
    border: 1px solid #d9dce4;
}

QPushButton#IconButton {
    padding: 0;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    font-size: 14px;
}

/* ---------------------------------------------------------------- inputs */

QComboBox {
    background-color: #ffffff;
    border: 1px solid #d9dce4;
    border-radius: 9px;
    padding: 7px 12px;
    color: #1b1c21;
}

QComboBox:hover {
    border: 1px solid #d62f3d;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    selection-background-color: #d62f3d;
    selection-color: #ffffff;
    border: 1px solid #d9dce4;
    outline: none;
    padding: 4px;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QKeySequenceEdit {
    background-color: #ffffff;
    border: 1px solid #d9dce4;
    border-radius: 9px;
    padding: 7px 12px;
    color: #1b1c21;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #d62f3d;
}

QCheckBox {
    spacing: 10px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #c3c7d1;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border: 1px solid #d62f3d;
}

QCheckBox::indicator:checked {
    background-color: #d62f3d;
    border: 1px solid #d62f3d;
    image: url(@ICONS@/check.png);
}

QSlider::groove:horizontal {
    height: 4px;
    background: #d9dce4;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #d62f3d;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 3px solid #d62f3d;
    width: 12px;
    height: 12px;
    margin: -7px 0;
    border-radius: 9px;
}

/* ---------------------------------------------------------------- lists & tables */

QListWidget, QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e3e5ec;
    border-radius: 10px;
    gridline-color: #e3e5ec;
    alternate-background-color: #f8f9fb;
}

QListWidget::item {
    padding: 7px;
    border-radius: 6px;
}

QListWidget::item:hover {
    background-color: #f4f5f8;
}

QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #d62f3d;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #f4f5f8;
    color: #6b7080;
    border: none;
    border-bottom: 1px solid #e3e5ec;
    padding: 7px 8px;
    font-weight: 700;
}

/* ---------------------------------------------------------------- tabs & groups */

QTabWidget::pane {
    border: 1px solid #e3e5ec;
    border-radius: 10px;
    top: -1px;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: transparent;
    color: #6b7080;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: #1b1c21;
}

QTabBar::tab:selected {
    color: #111216;
    border-bottom: 2px solid #d62f3d;
}

QGroupBox {
    border: 1px solid #e3e5ec;
    border-radius: 12px;
    margin-top: 14px;
    padding: 14px 12px 10px 12px;
    font-weight: 700;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #6b7080;
}

/* ---------------------------------------------------------------- menus */

QMenuBar {
    background-color: #ffffff;
    color: #4a4e5a;
    padding: 2px 6px;
}

QMenuBar::item {
    padding: 5px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #eef0f4;
    color: #111216;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d9dce4;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 22px 6px 14px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #d62f3d;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #e3e5ec;
    margin: 4px 8px;
}

/* ---------------------------------------------------------------- scrollbars */

QScrollArea {
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #d9dce4;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #d62f3d;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
