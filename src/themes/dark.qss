/*
 * Phantom Dark: the default theme of DePhantom Universal Death Counter.
 *
 * Layers, darkest to lightest: window #0b0c10, sidebar/top bar #0f1016,
 * cards #16171e, controls #1e2028. Crimson (#ff3d55) marks what matters:
 * the death count, the main buttons, the selected page. DePhantom purple
 * (#a855f7) is for the brand touches only.
 *
 * Keep the first rule's "background-color" / "color" lines as they are:
 * theme_manager swaps them for the player's text color and background image.
 */

QWidget {
    background-color: #0b0c10;
    color: #ececf1;
    font-family: "Segoe UI Variable Text", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #0b0c10;
}

QToolTip {
    background-color: #1e2028;
    color: #ececf1;
    border: 1px solid #2c2f3a;
    border-radius: 8px;
    padding: 6px 9px;
}

QLabel {
    background-color: transparent;
}

/* ---------------------------------------------------------------- shell */

QFrame#TopBar {
    background-color: #0f1016;
    border-bottom: 1px solid #1c1e26;
}

QFrame#TopBar QWidget, QFrame#Sidebar QWidget {
    background-color: transparent;
}

QLabel#TitleLabel {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 19px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.3px;
}

QLabel#Subtitle {
    color: #ff3d55;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#PageBadge {
    color: #8a8f9c;
    font-size: 12px;
    font-weight: 600;
    padding-left: 14px;
    border-left: 1px solid #262833;
}

QPushButton#TopIconButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 0;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
}

QPushButton#TopIconButton:hover {
    background-color: #1a1c24;
    border: 1px solid #2c2f3a;
}

QPushButton#TopIconButton::menu-indicator {
    image: none;
    width: 0;
}

QFrame#Sidebar {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                      stop: 0 #0f1016, stop: 1 #0c0d12);
    border-right: 1px solid #1c1e26;
}

QLabel#NavSection {
    color: #4f5361;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
    padding: 14px 22px 6px 22px;
}

QPushButton#NavButton {
    background-color: transparent;
    color: #8a8f9c;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 9px 12px;
    margin: 1px 10px;
    text-align: left;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#NavButton:hover {
    color: #ececf1;
    background-color: #16171e;
}

QPushButton#NavButton:checked {
    color: #ffffff;
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                      stop: 0 rgba(255, 61, 85, 0.22),
                                      stop: 1 rgba(255, 61, 85, 0.04));
    border: 1px solid rgba(255, 61, 85, 0.35);
}

QLabel#NavState {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
    border-radius: 7px;
    padding: 2px 7px;
    color: #6b6f7b;
    background-color: #1a1c24;
    border: 1px solid #262833;
}

QLabel#NavState[on="true"] {
    color: #0b0c10;
    background-color: #3ad07a;
    border: 1px solid #3ad07a;
}

QFrame#CreditCard {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                      stop: 0 rgba(168, 85, 247, 0.16),
                                      stop: 1 rgba(168, 85, 247, 0.03));
    border: 1px solid rgba(168, 85, 247, 0.30);
    border-radius: 12px;
}

QFrame#CreditCard:hover {
    border: 1px solid rgba(168, 85, 247, 0.70);
}

QLabel#CreditSmall {
    color: #8a8f9c;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

QLabel#CreditName {
    color: #d8b4fe;
    font-size: 13px;
    font-weight: 800;
}

QLabel#NavFooter {
    color: #4f5361;
    font-size: 10px;
    padding: 6px 22px 2px 22px;
}

QLabel#PageTitle {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 22px;
    font-weight: 800;
    color: #ffffff;
}

QLabel#PageSubtitle, QLabel#Muted {
    color: #8a8f9c;
    font-size: 12px;
}

QLabel#FieldLabel, QLabel#SectionTitle {
    color: #6b6f7b;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.8px;
}

/* ---------------------------------------------------------------- cards */

QFrame#Card, QFrame#StatTile {
    background-color: #16171e;
    border: 1px solid #22242d;
    border-radius: 16px;
}

QFrame#StatTile {
    background-color: rgba(255, 255, 255, 0.025);
    border: 1px solid #23252f;
    border-radius: 14px;
}

QFrame#HeroCard {
    border: 1px solid #3a1820;
    border-radius: 20px;
    background-color: qradialgradient(cx: 0.5, cy: 0.0, radius: 1.1, fx: 0.5, fy: 0.0,
                                      stop: 0 #3a121c, stop: 0.55 #19141a, stop: 1 #14151b);
}

QLabel#CounterLabel {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 92px;
    font-weight: 900;
    color: #ff3d55;
}

QLabel#CounterCaption, QPushButton#CounterCaption {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 4px;
    color: #b3b6c2;
}

/* The caption under the big number is also the switch for what it counts. */
QPushButton#CounterCaption {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 4px 10px;
    min-height: 0;
}

QPushButton#CounterCaption:hover {
    color: #ececf1;
    border-color: rgba(179, 182, 194, 90);
}

QLabel#SubCounterLabel {
    font-size: 13px;
    color: #8a8f9c;
}

QLabel#StatValue {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 24px;
    font-weight: 800;
    color: #ffffff;
}

QLabel#StatLabel {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #7d8290;
}

QLabel#TimerValue {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 60px;
    font-weight: 800;
    color: #ffffff;
}

QLabel#StatusPill {
    background-color: #1e2028;
    border: 1px solid #2c2f3a;
    border-radius: 13px;
    padding: 5px 14px;
    color: #c4c7d0;
    font-size: 12px;
    font-weight: 600;
}

QLabel#StatusPill[state="active"] {
    background-color: rgba(58, 208, 122, 0.12);
    border: 1px solid rgba(58, 208, 122, 0.45);
    color: #7ee2a8;
}

QLabel#StatusPill[state="warning"] {
    background-color: rgba(240, 160, 48, 0.12);
    border: 1px solid rgba(240, 160, 48, 0.45);
    color: #f3bd6b;
}

QLabel#KeyCap {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-bottom: 2px solid rgba(255, 255, 255, 0.20);
    border-radius: 6px;
    padding: 1px 7px;
    font-size: 11px;
    font-weight: 700;
    color: #b3b6c2;
}

QLabel#GuideBadge {
    background-color: rgba(255, 61, 85, 0.14);
    border: 1px solid rgba(255, 61, 85, 0.35);
    border-radius: 36px;
}

/* ---------------------------------------------------------------- buttons */

QPushButton {
    background-color: #1e2028;
    color: #ececf1;
    border: 1px solid #2c2f3a;
    border-radius: 10px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #252833;
    border: 1px solid #3c404d;
}

QPushButton:pressed {
    background-color: #16171e;
}

QPushButton:checked {
    border: 1px solid rgba(255, 61, 85, 0.6);
    background-color: rgba(255, 61, 85, 0.12);
}

QPushButton:disabled {
    color: #555a66;
    border: 1px solid #1e2028;
}

QPushButton QLabel {
    background-color: transparent;
}

QPushButton#AccentButton {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                      stop: 0 #ff4d63, stop: 1 #d91f3c);
    color: #ffffff;
    border: 1px solid #ff6a7d;
}

QPushButton#AccentButton:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                      stop: 0 #ff6477, stop: 1 #e82d4a);
}

QPushButton#AccentButton:pressed {
    background-color: #c51b36;
}

QPushButton#AccentButton QLabel {
    color: #ffffff;
}

QPushButton#AccentButton QLabel#KeyCap {
    background-color: rgba(0, 0, 0, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.30);
    border-bottom: 2px solid rgba(255, 255, 255, 0.40);
    color: #ffffff;
}

QPushButton#DangerButton {
    background-color: transparent;
    color: #ff6b7b;
    border: 1px solid #45222a;
}

QPushButton#DangerButton:hover {
    background-color: rgba(255, 61, 85, 0.10);
    border: 1px solid #ff3d55;
}

QPushButton#DangerButton QLabel {
    color: #ff6b7b;
}

QPushButton#GhostButton {
    background-color: transparent;
    color: #a0a4b0;
    border: 1px solid transparent;
}

QPushButton#GhostButton:hover {
    color: #ffffff;
    background-color: #16171e;
    border: 1px solid #2c2f3a;
}

QPushButton#IconButton {
    padding: 0;
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    border-radius: 10px;
}

QPushButton#IconButton:hover {
    border: 1px solid #ff3d55;
}

/* ---------------------------------------------------------------- inputs */

QComboBox {
    background-color: #1e2028;
    border: 1px solid #2c2f3a;
    border-radius: 10px;
    padding: 8px 12px;
    color: #ececf1;
}

QComboBox:hover {
    border: 1px solid #3c404d;
}

QComboBox:focus {
    border: 1px solid #4a4e5c;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox::down-arrow {
    image: url(@ICONS@/ui/chevron-down-dark.png);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background-color: #16171e;
    selection-background-color: #ff3d55;
    selection-color: #ffffff;
    border: 1px solid #2c2f3a;
    border-radius: 8px;
    outline: none;
    padding: 4px;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QKeySequenceEdit {
    background-color: #1e2028;
    border: 1px solid #2c2f3a;
    border-radius: 10px;
    padding: 7px 12px;
    color: #ececf1;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #ff3d55;
}

QCheckBox {
    spacing: 10px;
    background-color: transparent;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 1px solid #3a3e4a;
    background-color: #1e2028;
}

QCheckBox::indicator:hover {
    border: 1px solid #ff3d55;
}

QCheckBox::indicator:checked {
    background-color: #ff3d55;
    border: 1px solid #ff3d55;
    image: url(@ICONS@/check.png);
}

QSlider {
    background-color: transparent;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #2c2f3a;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #ff3d55;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 3px solid #ff3d55;
    width: 12px;
    height: 12px;
    margin: -7px 0;
    border-radius: 9px;
}

QProgressBar {
    background-color: #1e2028;
    border: 1px solid #2c2f3a;
    border-radius: 8px;
    text-align: center;
    color: #ececf1;
}

QProgressBar::chunk {
    background-color: #ff3d55;
    border-radius: 7px;
}

/* ---------------------------------------------------------------- lists & tables */

QListWidget, QTableWidget {
    background-color: #16171e;
    border: 1px solid #22242d;
    border-radius: 12px;
    gridline-color: #22242d;
    alternate-background-color: #191a22;
    padding: 4px;
}

QListWidget::item {
    padding: 8px;
    border-radius: 8px;
}

QListWidget::item:hover {
    background-color: #1e2028;
}

QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #ff3d55;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #0f1016;
    color: #8a8f9c;
    border: none;
    border-bottom: 1px solid #22242d;
    padding: 7px 8px;
    font-weight: 700;
}

/* ---------------------------------------------------------------- tabs & groups */

QTabWidget::pane {
    border: 1px solid #22242d;
    border-radius: 14px;
    top: -1px;
    background-color: #0f1016;
}

QTabBar::tab {
    background-color: transparent;
    color: #8a8f9c;
    padding: 9px 16px;
    margin-right: 4px;
    border: 1px solid transparent;
    border-radius: 10px;
    font-weight: 700;
}

QTabBar::tab:hover {
    color: #ececf1;
    background-color: #16171e;
}

QTabBar::tab:selected {
    color: #ffffff;
    background-color: rgba(255, 61, 85, 0.14);
    border: 1px solid rgba(255, 61, 85, 0.40);
}

QGroupBox {
    background-color: #13141a;
    border: 1px solid #22242d;
    border-radius: 14px;
    margin-top: 16px;
    padding: 16px 14px 12px 14px;
    font-weight: 800;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #8a8f9c;
}

QGroupBox QWidget {
    background-color: transparent;
}

QGroupBox QComboBox, QGroupBox QLineEdit, QGroupBox QSpinBox,
QGroupBox QDoubleSpinBox, QGroupBox QKeySequenceEdit, QGroupBox QPushButton {
    background-color: #1e2028;
}

QFrame#ThemeCard {
    background-color: #16171e;
    border: 1px solid #22242d;
    border-radius: 14px;
}

QFrame#ThemeCard:hover {
    border: 1px solid #3c404d;
}

QFrame#ThemeCard[selected="true"] {
    border: 2px solid #ff3d55;
}

QFrame#ThemeCard QWidget {
    background-color: transparent;
}

QFrame#ThemeCard QPushButton {
    background-color: #1e2028;
    padding: 4px 10px;
    font-size: 12px;
}

/* ---------------------------------------------------------------- menus */

QMenuBar {
    background-color: #0f1016;
    color: #a0a4b0;
}

QMenu {
    background-color: #16171e;
    border: 1px solid #2c2f3a;
    border-radius: 10px;
    padding: 5px;
}

QMenu::item {
    padding: 7px 24px 7px 12px;
    border-radius: 7px;
    background-color: transparent;
}

QMenu::item:selected {
    background-color: rgba(255, 61, 85, 0.85);
    color: #ffffff;
}

QMenu::item:disabled {
    color: #555a66;
}

QMenu::icon {
    padding-left: 8px;
}

QMenu::separator {
    height: 1px;
    background: #2c2f3a;
    margin: 5px 8px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 6px;
}

/* ---------------------------------------------------------------- scrollbars */

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #2c2f3a;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #ff3d55;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ---------------------------------------------------------------- update card */

QFrame#UpdateCard {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid #22242d;
    border-radius: 12px;
}

QFrame#UpdateCard[state="available"] {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                      stop: 0 rgba(255, 61, 85, 0.16), stop: 1 rgba(255, 61, 85, 0.03));
    border: 1px solid rgba(255, 61, 85, 0.45);
}

QFrame#UpdateCard QWidget {
    background-color: transparent;
}

QLabel#UpdateTitle {
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
}

QLabel#UpdateDetail {
    color: #8a8f9c;
    font-size: 11px;
}

QPushButton#UpdateCheck {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 0;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
}

QPushButton#UpdateCheck:hover {
    background-color: #1a1c24;
    border: 1px solid #22242d;
}

QFrame#UpdateCard QPushButton#AccentButton {
    padding: 7px 10px;
    font-size: 12px;
}

QLabel#PhoneLink {
    color: #ececf1;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 15px;
    font-weight: 700;
    padding: 10px 12px;
    border: 1px dashed rgba(128, 128, 128, 0.45);
    border-radius: 10px;
}

/* ---------------------------------------------------------------- home dashboard */

QLabel#DateChip {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid #22242d;
    border-radius: 13px;
    padding: 5px 12px;
    color: #8a8f9c;
    font-size: 12px;
    font-weight: 600;
}

QLabel#TierName {
    font-size: 13px;
    font-weight: 800;
    color: #ffffff;
}

QLabel#TierHint {
    font-size: 11px;
    color: #8a8f9c;
}

QProgressBar#TierProgress {
    background-color: rgba(255, 255, 255, 0.05);
    border: none;
    border-radius: 3px;
}

QProgressBar#TierProgress::chunk {
    background-color: #ff3d55;
    border-radius: 3px;
}

QLabel#InsightValue {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 24px;
    font-weight: 800;
    color: #ffffff;
}

QLabel#DeltaChip {
    border-radius: 11px;
    border: 1px solid transparent;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
    background-color: rgba(255, 255, 255, 0.05);
    color: #8a8f9c;
}

QLabel#DeltaChip[tone="up"] {
    border-radius: 11px;
    border: 1px solid transparent;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
    background-color: rgba(255, 61, 85, 0.14);
    color: #ff3d55;
}

QLabel#DeltaChip[tone="down"] {
    border-radius: 11px;
    border: 1px solid transparent;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
    background-color: rgba(58, 208, 122, 0.14);
    color: #7ee2a8;
}

QFrame#StartBanner {
    background-color: rgba(255, 61, 85, 0.08);
    border: 1px solid rgba(255, 61, 85, 0.32);
    border-radius: 16px;
}

QLabel#StartBannerIcon {
    background-color: rgba(255, 61, 85, 0.16);
    border-radius: 19px;
}

QLabel#StartBannerTitle, QLabel#StepTitle {
    font-size: 14px;
    font-weight: 800;
    color: #ffffff;
}

QFrame#GuideStep {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid #22242d;
    border-radius: 14px;
}

QFrame#GuideStep[done="true"] {
    background-color: rgba(58, 208, 122, 0.06);
    border: 1px solid rgba(58, 208, 122, 0.30);
}

QLabel#StepMark {
    background-color: rgba(255, 61, 85, 0.14);
    border: 1px solid rgba(255, 61, 85, 0.40);
    border-radius: 15px;
    color: #ff3d55;
    font-weight: 800;
}

QLabel#StepMark[done="true"] {
    background-color: rgb(58, 208, 122);
    border: 1px solid rgb(58, 208, 122);
}
