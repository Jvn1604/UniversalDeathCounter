/*
 * Clay: soft, puffy white shapes on lavender with pastel blobs.
 * Built by packaging/make_themes.py from Daylight:
 * edit that script, not this file.
 */

QWidget {
    background-color: #efecfa;
    color: #1e2145;
    font-family: "Segoe UI Variable Text", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #efecfa;
}

QToolTip {
    background-color: #f3f0fd;
    color: #1e2145;
    border: 1px solid #ddd5f5;
    border-radius: 8px;
    padding: 6px 9px;
}

QLabel {
    background-color: transparent;
}

/* ---------------------------------------------------------------- shell */

QFrame#TopBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e9e4f8;
}

QFrame#TopBar QWidget, QFrame#Sidebar QWidget {
    background-color: transparent;
}

QLabel#TitleLabel {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 19px;
    font-weight: 800;
    color: #15173a;
    letter-spacing: 0.3px;
}

QLabel#Subtitle {
    color: #6c5ce7;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#PageBadge {
    color: #6b6890;
    font-size: 12px;
    font-weight: 600;
    padding-left: 14px;
    border-left: 1px solid #e6e0f8;
}

QPushButton#TopIconButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 0;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
}

QPushButton#TopIconButton:hover {
    background-color: #efebfb;
    border: 1px solid #ddd5f5;
}

QPushButton#TopIconButton::menu-indicator {
    image: none;
    width: 0;
}

QFrame#Sidebar {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                      stop: 0 #ffffff, stop: 1 #f8f6ff);
    border-right: 1px solid #e9e4f8;
}

QLabel#NavSection {
    color: #9a9eaa;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
    padding: 14px 22px 6px 22px;
}

QPushButton#NavButton {
    background-color: transparent;
    color: #6b6890;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 9px 12px;
    margin: 1px 10px;
    text-align: left;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#NavButton:hover {
    color: #1e2145;
    background-color: #f3f0fd;
}

QPushButton#NavButton:checked {
    color: #15173a;
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                      stop: 0 rgba(108, 92, 231, 0.22),
                                      stop: 1 rgba(108, 92, 231, 0.04));
    border: 1px solid rgba(108, 92, 231, 0.35);
}

QLabel#NavState {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
    border-radius: 7px;
    padding: 2px 7px;
    color: #7d7a9e;
    background-color: #efebfb;
    border: 1px solid #e6e0f8;
}

QLabel#NavState[on="true"] {
    color: #ffffff;
    background-color: #1f9d55;
    border: 1px solid #1f9d55;
}

QFrame#CreditCard {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                      stop: 0 rgba(126, 34, 206, 0.16),
                                      stop: 1 rgba(126, 34, 206, 0.03));
    border: 1px solid rgba(126, 34, 206, 0.30);
    border-radius: 12px;
}

QFrame#CreditCard:hover {
    border: 1px solid rgba(126, 34, 206, 0.70);
}

QLabel#CreditSmall {
    color: #6b6890;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

QLabel#CreditName {
    color: #7e22ce;
    font-size: 13px;
    font-weight: 800;
}

QLabel#NavFooter {
    color: #9a9eaa;
    font-size: 10px;
    padding: 6px 22px 2px 22px;
}

QLabel#PageTitle {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 22px;
    font-weight: 800;
    color: #15173a;
}

QLabel#PageSubtitle, QLabel#Muted {
    color: #6b6890;
    font-size: 12px;
}

QLabel#FieldLabel, QLabel#SectionTitle {
    color: #7d7a9e;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.8px;
}

/* ---------------------------------------------------------------- cards */

QFrame#Card, QFrame#StatTile {
    background-color: #ffffff;
    border: 1px solid #e6e0f8;
    border-radius: 16px;
}

QFrame#StatTile {
    background-color: rgba(46, 34, 120, 0.015);
    border: 1px solid #e6e0f8;
    border-radius: 14px;
}

QFrame#HeroCard {
    border: 1px solid #f5c6ce;
    border-radius: 20px;
    background-color: qradialgradient(cx: 0.5, cy: 0.0, radius: 1.1, fx: 0.5, fy: 0.0,
                                      stop: 0 #e7e1ff, stop: 0.55 #f6f3ff, stop: 1 #ffffff);
}

QLabel#CounterLabel {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 92px;
    font-weight: 900;
    color: #6c5ce7;
}

QLabel#CounterCaption, QPushButton#CounterCaption {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 4px;
    color: #4e4b73;
}

/* The caption under the big number is also the switch for what it counts. */
QPushButton#CounterCaption {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 4px 10px;
    min-height: 16px; /* text + arrow; 0 would let the layout clip the text */
}

QPushButton#CounterCaption:hover {
    color: #1e2145;
    border-color: rgba(74, 78, 90, 90);
}

QLabel#HomeCount {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 54px;
    font-weight: 900;
    color: #6c5ce7;
}

/* Collapsed sidebar: icons only, centered. */
QPushButton#NavButton[collapsed="true"] {
    padding: 9px 0px;
    text-align: center;
}

QLabel#SubCounterLabel {
    font-size: 13px;
    color: #6b6890;
}

QLabel#StatValue {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 24px;
    font-weight: 800;
    color: #15173a;
}

QLabel#StatLabel {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #6b6f7b;
}

QLabel#TimerValue {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 60px;
    font-weight: 800;
    color: #15173a;
}

QLabel#StatusPill {
    background-color: #f3f0fd;
    border: 1px solid #ddd5f5;
    border-radius: 13px;
    padding: 5px 14px;
    color: #3b3e48;
    font-size: 12px;
    font-weight: 600;
}

QLabel#StatusPill[state="active"] {
    background-color: rgba(58, 208, 122, 0.12);
    border: 1px solid rgba(58, 208, 122, 0.45);
    color: #157a41;
}

QLabel#StatusPill[state="waiting"] {
    background-color: rgba(214, 160, 20, 0.12);
    border: 1px solid rgba(214, 160, 20, 0.45);
    color: #8a6a0c;
}

QLabel#StatusPill[state="warning"] {
    background-color: rgba(240, 160, 48, 0.12);
    border: 1px solid rgba(240, 160, 48, 0.45);
    color: #a3620a;
}

QLabel#KeyCap {
    background-color: rgba(46, 34, 120, 0.036);
    border: 1px solid rgba(46, 34, 120, 0.084);
    border-bottom: 2px solid rgba(46, 34, 120, 0.120);
    border-radius: 6px;
    padding: 1px 7px;
    font-size: 11px;
    font-weight: 700;
    color: #4e4b73;
}

QLabel#GuideBadge {
    background-color: rgba(108, 92, 231, 0.14);
    border: 1px solid rgba(108, 92, 231, 0.35);
    border-radius: 36px;
}

/* ---------------------------------------------------------------- buttons */

QPushButton {
    background-color: #f3f0fd;
    color: #1e2145;
    border: 1px solid #ddd5f5;
    border-radius: 10px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #e6e8ee;
    border: 1px solid #c9bff0;
}

QPushButton:pressed {
    background-color: #ffffff;
}

QPushButton:checked {
    border: 1px solid rgba(108, 92, 231, 0.6);
    background-color: rgba(108, 92, 231, 0.12);
}

QPushButton:disabled {
    color: #a5a9b4;
    border: 1px solid #f3f0fd;
}

QPushButton QLabel {
    background-color: transparent;
}

QPushButton#AccentButton {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                      stop: 0 #f0384f, stop: 1 #cc1734);
    color: #ffffff;
    border: 1px solid #6c5ce7;
}

QPushButton#AccentButton:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                      stop: 0 #f54d62, stop: 1 #d92440);
}

QPushButton#AccentButton:pressed {
    background-color: #b8142e;
}

QPushButton#AccentButton QLabel {
    color: #ffffff;
}

QPushButton#AccentButton QLabel#KeyCap {
    background-color: rgba(0, 0, 0, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-bottom: 2px solid rgba(255, 255, 255, 0.45);
    color: #ffffff;
}

QPushButton#DangerButton {
    background-color: transparent;
    color: #cc1f37;
    border: 1px solid #f2b8c1;
}

QPushButton#DangerButton:hover {
    background-color: rgba(108, 92, 231, 0.10);
    border: 1px solid #6c5ce7;
}

QPushButton#DangerButton QLabel {
    color: #cc1f37;
}

QPushButton#GhostButton {
    background-color: transparent;
    color: #5c5980;
    border: 1px solid transparent;
}

QPushButton#GhostButton:hover {
    color: #15173a;
    background-color: #f3f0fd;
    border: 1px solid #ddd5f5;
}

QPushButton#IconButton {
    padding: 0;
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    border-radius: 10px;
}

QPushButton#IconButton:hover {
    border: 1px solid #6c5ce7;
}

/* ---------------------------------------------------------------- inputs */

QComboBox {
    background-color: #f3f0fd;
    border: 1px solid #ddd5f5;
    border-radius: 10px;
    padding: 8px 12px;
    color: #1e2145;
}

QComboBox:hover {
    border: 1px solid #c9bff0;
}

QComboBox:focus {
    border: 1px solid #b4b8c3;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox::down-arrow {
    image: url(@ICONS@/ui/chevron-down-light.png);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    selection-background-color: #6c5ce7;
    selection-color: #ffffff;
    border: 1px solid #ddd5f5;
    border-radius: 8px;
    outline: none;
    padding: 4px;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QKeySequenceEdit {
    background-color: #f3f0fd;
    border: 1px solid #ddd5f5;
    border-radius: 10px;
    padding: 7px 12px;
    color: #1e2145;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #6c5ce7;
}

QCheckBox {
    spacing: 10px;
    background-color: transparent;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 1px solid #c9bff0;
    background-color: #f3f0fd;
}

QCheckBox::indicator:hover {
    border: 1px solid #6c5ce7;
}

QCheckBox::indicator:checked {
    background-color: #6c5ce7;
    border: 1px solid #6c5ce7;
    image: url(@ICONS@/check.png);
}

QSlider {
    background-color: transparent;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #ddd5f5;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #6c5ce7;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 3px solid #6c5ce7;
    width: 12px;
    height: 12px;
    margin: -7px 0;
    border-radius: 9px;
}

QProgressBar {
    background-color: #f3f0fd;
    border: 1px solid #ddd5f5;
    border-radius: 8px;
    text-align: center;
    color: #1e2145;
}

QProgressBar::chunk {
    background-color: #6c5ce7;
    border-radius: 7px;
}

/* ---------------------------------------------------------------- lists & tables */

QListWidget, QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e6e0f8;
    border-radius: 12px;
    gridline-color: #e6e0f8;
    alternate-background-color: #f6f7fa;
    padding: 4px;
}

QListWidget::item {
    padding: 8px;
    border-radius: 8px;
}

QListWidget::item:hover {
    background-color: #f3f0fd;
}

QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #6c5ce7;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #ffffff;
    color: #6b6890;
    border: none;
    border-bottom: 1px solid #e6e0f8;
    padding: 7px 8px;
    font-weight: 700;
}

/* ---------------------------------------------------------------- tabs & groups */

QTabWidget::pane {
    border: 1px solid #e6e0f8;
    border-radius: 14px;
    top: -1px;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: transparent;
    color: #6b6890;
    padding: 9px 16px;
    margin-right: 4px;
    border: 1px solid transparent;
    border-radius: 10px;
    font-weight: 700;
}

QTabBar::tab:hover {
    color: #1e2145;
    background-color: #ffffff;
}

QTabBar::tab:selected {
    color: #15173a;
    background-color: rgba(108, 92, 231, 0.14);
    border: 1px solid rgba(108, 92, 231, 0.40);
}

QGroupBox {
    background-color: #f8f6ff;
    border: 1px solid #e6e0f8;
    border-radius: 14px;
    margin-top: 16px;
    padding: 16px 14px 12px 14px;
    font-weight: 800;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #6b6890;
}

QGroupBox QWidget {
    background-color: transparent;
}

QGroupBox QComboBox, QGroupBox QLineEdit, QGroupBox QSpinBox,
QGroupBox QDoubleSpinBox, QGroupBox QKeySequenceEdit, QGroupBox QPushButton {
    background-color: #f3f0fd;
}

QFrame#ThemeCard {
    background-color: #ffffff;
    border: 1px solid #e6e0f8;
    border-radius: 14px;
}

QFrame#ThemeCard:hover {
    border: 1px solid #c9bff0;
}

QFrame#ThemeCard[selected="true"] {
    border: 2px solid #6c5ce7;
}

QFrame#ThemeCard QWidget {
    background-color: transparent;
}

QFrame#ThemeCard QPushButton {
    background-color: #f3f0fd;
    padding: 4px 10px;
    font-size: 12px;
}

/* ---------------------------------------------------------------- menus */

QMenuBar {
    background-color: #ffffff;
    color: #5c5980;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #ddd5f5;
    border-radius: 10px;
    padding: 5px;
}

QMenu::item {
    padding: 7px 24px 7px 12px;
    border-radius: 7px;
    background-color: transparent;
}

QMenu::item:selected {
    background-color: rgba(108, 92, 231, 0.85);
    color: #ffffff;
}

QMenu::item:disabled {
    color: #a5a9b4;
}

QMenu::icon {
    padding-left: 8px;
}

QMenu::separator {
    height: 1px;
    background: #ddd5f5;
    margin: 5px 8px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 6px;
}

/* ---------------------------------------------------------------- scrollbars */

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #ddd5f5;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #6c5ce7;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ---------------------------------------------------------------- update card */

QFrame#UpdateCard {
    background-color: #ffffff;
    border: 1px solid #e6e0f8;
    border-radius: 12px;
}

QFrame#UpdateCard[state="available"] {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                      stop: 0 rgba(108, 92, 231, 0.12), stop: 1 rgba(108, 92, 231, 0.02));
    border: 1px solid rgba(108, 92, 231, 0.40);
}

QFrame#UpdateCard QWidget {
    background-color: transparent;
}

QLabel#UpdateTitle {
    color: #15173a;
    font-size: 12px;
    font-weight: 800;
}

QLabel#UpdateDetail {
    color: #6b6890;
    font-size: 11px;
}

QPushButton#UpdateCheck {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 0;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
}

QPushButton#UpdateCheck:hover {
    background-color: #f3f0fd;
    border: 1px solid #e6e0f8;
}

QFrame#UpdateCard QPushButton#AccentButton {
    padding: 7px 10px;
    font-size: 12px;
}

QLabel#PhoneLink {
    color: #1e2145;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 15px;
    font-weight: 700;
    padding: 10px 12px;
    border: 1px dashed rgba(128, 128, 128, 0.45);
    border-radius: 10px;
}

/* ---------------------------------------------------------------- home dashboard */

QLabel#DateChip {
    background-color: rgba(46, 34, 120, 0.06);
    border: 1px solid #e6e0f8;
    border-radius: 13px;
    padding: 5px 12px;
    color: #6b6890;
    font-size: 12px;
    font-weight: 600;
}

QLabel#TierName {
    font-size: 13px;
    font-weight: 800;
    color: #15173a;
}

QLabel#TierHint {
    font-size: 11px;
    color: #6b6890;
}

QProgressBar#TierProgress {
    background-color: rgba(46, 34, 120, 0.06);
    border: none;
    border-radius: 3px;
}

QProgressBar#TierProgress::chunk {
    background-color: #6c5ce7;
    border-radius: 3px;
}

QLabel#InsightValue {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 24px;
    font-weight: 800;
    color: #15173a;
}

QLabel#DeltaChip {
    border-radius: 11px;
    border: 1px solid transparent;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
    background-color: rgba(46, 34, 120, 0.06);
    color: #6b6890;
}

QLabel#DeltaChip[tone="up"] {
    border-radius: 11px;
    border: 1px solid transparent;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
    background-color: rgba(108, 92, 231, 0.14);
    color: #6c5ce7;
}

QLabel#DeltaChip[tone="down"] {
    border-radius: 11px;
    border: 1px solid transparent;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
    background-color: rgba(31, 143, 82, 0.14);
    color: #1f8f52;
}

QFrame#StartBanner {
    background-color: rgba(108, 92, 231, 0.08);
    border: 1px solid rgba(108, 92, 231, 0.32);
    border-radius: 16px;
}

QLabel#StartBannerIcon {
    background-color: rgba(108, 92, 231, 0.16);
    border-radius: 19px;
}

QLabel#StartBannerTitle, QLabel#StepTitle {
    font-size: 14px;
    font-weight: 800;
    color: #15173a;
}

QFrame#GuideStep {
    background-color: rgba(46, 34, 120, 0.06);
    border: 1px solid #e6e0f8;
    border-radius: 14px;
}

QFrame#GuideStep[done="true"] {
    background-color: rgba(31, 143, 82, 0.06);
    border: 1px solid rgba(31, 143, 82, 0.30);
}

QLabel#StepMark {
    background-color: rgba(108, 92, 231, 0.14);
    border: 1px solid rgba(108, 92, 231, 0.40);
    border-radius: 15px;
    color: #6c5ce7;
    font-weight: 800;
}

QLabel#StepMark[done="true"] {
    background-color: rgb(31, 143, 82);
    border: 1px solid rgb(31, 143, 82);
}

/* ================================================================ Clay layer
 * Soft, puffy white shapes on lavender with pastel blobs behind: a light
 * top edge and a deeper bottom edge make every card and button look
 * pressable, without shadow effects (they'd cost performance).
 */

QMainWindow, QDialog {
    background-color: #efecfa;
}

QFrame#TopBar {
    background-color: rgba(255, 255, 255, 0.55);
    border-bottom: 1px solid rgba(255, 255, 255, 0.85);
}

QFrame#Sidebar {
    background-color: rgba(255, 255, 255, 0.50);
    border-right: 1px solid rgba(255, 255, 255, 0.85);
}

QFrame#Card, QFrame#StatTile {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #ffffff, stop: 1 #f7f5ff);
    border: 1px solid #ffffff;
    border-bottom: 4px solid rgba(108, 92, 231, 0.14);
    border-radius: 22px;
}

QFrame#HeroCard {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #ffffff, stop: 0.6 #f6f3ff, stop: 1 #ebe5ff);
    border: 1px solid #ffffff;
    border-bottom: 5px solid rgba(108, 92, 231, 0.16);
    border-radius: 26px;
}

QPushButton {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #ffffff, stop: 1 #f2eefd);
    border: 1px solid #ffffff;
    border-bottom: 3px solid rgba(108, 92, 231, 0.18);
    border-radius: 14px;
}

QPushButton:pressed {
    border-bottom: 1px solid rgba(108, 92, 231, 0.18);
}

QPushButton#NavButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 14px;
}

QPushButton#NavButton:hover {
    background-color: rgba(255, 255, 255, 0.60);
}

QPushButton#NavButton:checked {
    color: #1e2145;
    background-color: #ffffff;
    border: 1px solid #ffffff;
    border-bottom: 3px solid rgba(108, 92, 231, 0.20);
}

QPushButton#AccentButton {
    color: #ffffff;
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #8a7cf3, stop: 1 #6150e2);
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-bottom: 4px solid #4a3bc2;
    border-radius: 16px;
}

QPushButton#AccentButton:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #978af6, stop: 1 #6c5ce7);
}

QPushButton#AccentButton:pressed {
    border-bottom: 1px solid #4a3bc2;
}

QPushButton#GhostButton, QPushButton#TopIconButton, QPushButton#CounterCaption {
    background-color: transparent;
    border: 1px solid transparent;
}

QPushButton#DangerButton {
    color: #d93a4a;
    border-bottom: 3px solid rgba(217, 58, 74, 0.25);
}

QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox, QKeySequenceEdit {
    background-color: #ffffff;
    border: 1px solid #e6e0f8;
    border-bottom: 2px solid #ddd5f5;
    border-radius: 12px;
}

QCheckBox::indicator {
    border-radius: 7px;
}

QMenu, QComboBox QAbstractItemView, QComboBox QFrame, QToolTip {
    background-color: #ffffff;
}

QMessageBox, QInputDialog, QProgressDialog, QColorDialog, QFileDialog {
    background-color: #f6f4fd;
}
